# Copy to deploy/dgx/.env on the DGX Spark and fill in. (.env is gitignored.)
# Read by: models.compose.yml (model servers), start.sh (SURU API), setup.sh.

LLM_MODE=live

# ---- Model servers (deploy/dgx/models.compose.yml) ---------------------------------------
# NGC vLLM build for GB10/aarch64. Check https://catalog.ngc.nvidia.com/orgs/nvidia/containers/vllm
# for a newer tag; pin whatever passes `urban-response smoke`.
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05.post1-py3
# Needed to download weights (https://huggingface.co/settings/tokens).
HF_TOKEN=
HF_CACHE=~/.cache/huggingface

# Hugging Face checkpoints -> the short names the servers expose (QWEN_MODEL / NEMOTRON_MODEL
# are also what the SURU API asks for, so keep both sides in this one file).
QWEN_HF_MODEL=Qwen/Qwen3.5-35B-A3B-FP8
QWEN_MODEL=qwen3.5
NEMOTRON_HF_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
NEMOTRON_MODEL=nemotron-3-nano

# Fractions of the 128 GB unified memory. Keep the sum <= 0.80.
QWEN_GPU_MEM=0.40
NEMOTRON_GPU_MEM=0.38
QWEN_MAX_MODEL_LEN=32768
NEMOTRON_MAX_MODEL_LEN=32768
# Concurrent sequences per server. A burst of N incidents makes up to 3N parallel Nemotron calls.
QWEN_MAX_SEQS=16
NEMOTRON_MAX_SEQS=16

# ---- SURU API -> model servers -----------------------------------------------------------
# Keep them off port 8080, which the SURU API uses.
QWEN_BASE_URL=http://127.0.0.1:8001/v1
NEMOTRON_BASE_URL=http://127.0.0.1:8002/v1
# ---- Alternative: an Ollama server that is already running (no Docker access needed) ----
# UR_MODEL_SERVERS=external          # setup.sh then skips the vLLM containers
# QWEN_BASE_URL=http://127.0.0.1:11434/v1
# NEMOTRON_BASE_URL=http://127.0.0.1:11434/v1
# QWEN_MODEL=<tag from: curl -s localhost:11434/api/tags>
# NEMOTRON_MODEL=<tag>
# UR_REASONING_EFFORT=none           # Ollama ignores chat_template_kwargs; this turns thinking off
# and raise UR_LLM_TIMEOUT_S below to 240: Ollama loads each model on its first call

# Optional: run CR on its own server (default: shares the A1-A3 Nemotron server).
# CR_BASE_URL=http://127.0.0.1:8003/v1
# CR_MODEL=nemotron-3-super

# Set to 0 if the model server rejects response_format=json_schema
UR_GUIDED_JSON=1
# Sends chat_template_kwargs.enable_thinking=false (both Qwen 3.5 and Nemotron 3 honour it)
UR_DISABLE_THINKING=1
# Per-call timeout in seconds
UR_LLM_TIMEOUT_S=120
# Duplicate detection (MiniLM). setup.sh (or `uv run urban-response prefetch`) caches it while
# online; keep this at 1 so a venue internet drop can't stall dedup.
HF_HUB_OFFLINE=1
# Optional: local model directory instead of the Hugging Face name
# UR_MINILM_MODEL=/opt/models/all-MiniLM-L6-v2
# 1 = never merge reports whose triaged categories differ (safer); 0 = disable
UR_DEDUP_CATEGORY_GUARD=1
# Optional: agent skill prompts (A1-A3 SKILL.md, CR resource_allocator_skill). Default: repo copy.
# UR_SKILLS_DIR=/opt/suru/nemotron_resource_skills

# Shared secret between the Vercel proxy (SURU_BACKEND_TOKEN) and this API.
# Generate with: openssl rand -hex 32
# Required for any request arriving through the tunnel; direct LAN clients don't need it.
UR_API_TOKEN=

# API bind address and port
SURU_HOST=0.0.0.0
SURU_PORT=8080
